import os
import re
import sys
from typing import Tuple

import duckdb
import numpy as np
import pandas as pd
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
from sklearn.preprocessing import StandardScaler


def prepare_dummy_database(con: duckdb.DuckDBPyConnection, schema: str, features_table: str):
    """Tạo schema và dữ liệu giả lập nếu chưa có sẵn bảng features để code chạy ngay."""
    con.execute(f'CREATE SCHEMA IF NOT EXISTS "{schema}"')
    
    # Kiểm tra xem bảng input đã tồn tại chưa
    table_exists = con.execute(f"""
        SELECT COUNT(*) 
        FROM information_schema.tables 
        WHERE table_schema = '{schema}' AND table_name = '{features_table}'
    """).fetchone()[0]

    if not table_exists:
        print(f"⚠️  Không tìm thấy {schema}.{features_table}. Đang tạo dữ liệu giả lập để chạy thử...")
        np.random.seed(42)
        n_customers = 500
        
        # Tạo dữ liệu giả lập thực tế với độ lệch phải (skewed data)
        recency = np.random.exponential(scale=90, size=n_customers).astype(int)
        frequency = np.random.geometric(p=0.7, size=n_customers)
        monetary = (frequency * np.random.uniform(20, 200, size=n_customers) + np.random.exponential(scale=100, size=n_customers)).round(2)
        
        df_dummy = pd.DataFrame({
            "customer_unique_id": [f"cust_{i:05d}" for i in range(1, n_customers + 1)],
            "recency_days": recency,
            "frequency": frequency,
            "monetary": monetary,
            "last_purchase_date": pd.date_range(end="2024-12-31", periods=n_customers),
            "reference_date": pd.Timestamp("2025-01-01")
        })
        
        target_source = f'"{schema}"."{features_table}"'
        con.register("dummy_df", df_dummy)
        con.execute(f"CREATE TABLE {target_source} AS SELECT * FROM dummy_df")
        con.unregister("dummy_df")
        print(f"✅ Đã tạo bảng giả lập {schema}.{features_table} với {n_customers} khách hàng.\n")


def choose_k(x: np.ndarray, max_k: int) -> Tuple[int, float | None]:
    """Lựa chọn số cụm K tối ưu dựa trên Silhouette Score (K từ 2 đến max_k)."""
    n = len(x)
    if n < 3:
        return 1, None
    upper = min(max_k, n - 1)
    best_k, best_score = 2, -1.0
    for k in range(2, upper + 1):
        labels = KMeans(n_clusters=k, random_state=42, n_init=20).fit_predict(x)
        if len(set(labels)) < 2 or len(set(labels)) >= n:
            continue
        score = silhouette_score(x, labels)
        if score > best_score:
            best_k, best_score = k, score
    return best_k, (best_score if best_score >= -1.0 else None)


def assign_segment_labels(profile: pd.DataFrame) -> dict[int, str]:
    """Phân tích đặc điểm từng cụm theo giá trị trung vị (Median) và gán nhãn mô tả."""
    if profile.empty:
        return {}

    med_r = profile["recency_days"].median()
    med_f = profile["frequency"].median()
    med_m = profile["monetary"].median()
    labels: dict[int, str] = {}

    for row in profile.itertuples(index=False):
        cluster_id = int(row.cluster_id)
        r_high = row.recency_days > med_r       # Recency cao = đã lâu không mua hàng
        f_high = row.frequency >= med_f         # Frequency cao = mua nhiều đơn
        m_high = row.monetary >= med_m          # Monetary cao = chi tiêu nhiều

        if (not r_high) and f_high and m_high:
            label = "Khách hàng giá trị cao"
        elif r_high and (not f_high):
            label = "Khách hàng có nguy cơ rời bỏ"
        elif (not r_high) and (not f_high) and (not m_high):
            label = "Khách hàng mới / tiềm năng"
        elif f_high and (not m_high):
            label = "Khách hàng mua thường xuyên"
        else:
            label = "Khách hàng phổ thông"
        labels[cluster_id] = label

    return labels


def main() -> int:
    schema = os.getenv("MART_SCHEMA", "customer_mart")
    features_table = os.getenv("FEATURES_TABLE", "mart_customer_rfm_features")
    output_table = os.getenv("OUTPUT_TABLE", "mart_customer_rfm")
    max_k = int(os.getenv("MAX_K", "8"))
    db_path = os.getenv("DUCKDB_PATH", "olist_warehouse.duckdb")

    # 1. Kết nối DuckDB
    con = duckdb.connect(db_path)
    try:
        # Chuẩn bị bảng mẫu nếu chưa có dữ liệu đầu vào
        prepare_dummy_database(con, schema, features_table)

        source = f'"{schema}"."{features_table}"'
        target = f'"{schema}"."{output_table}"'

        # Bước 1: Trích xuất dữ liệu từ Data Mart
        print(f"📥 Đang đọc dữ liệu từ {source}...")
        df = con.execute(f"SELECT customer_unique_id, recency_days, frequency, monetary FROM {source}").df()

        if df.empty:
            raise RuntimeError("Bảng dữ liệu đầu vào rỗng!")
        if df["customer_unique_id"].duplicated().any():
            raise RuntimeError("Dữ liệu đầu vào chứa trùng lặp customer_unique_id!")

        # Bước 2: Tiền xử lý & Chuẩn hóa dữ liệu
        for col in ["recency_days", "frequency", "monetary"]:
            df[col] = pd.to_numeric(df[col], errors="coerce")
        df = df.dropna(subset=["recency_days", "frequency", "monetary"]).copy()
        df = df[(df["recency_days"] >= 0) & (df["frequency"] >= 1) & (df["monetary"] >= 0)].copy()

        # Dùng log1p giảm độ lệch (skewness), sau đó chuẩn hóa StandardScaler
        raw_x = df[["recency_days", "frequency", "monetary"]].to_numpy(dtype=float)
        x_log = np.log1p(raw_x)
        x_scaled = StandardScaler().fit_transform(x_log)

        # Bước 3: Lựa chọn số cụm K & Thực hiện K-Means
        best_k, score = choose_k(x_scaled, max_k)
        print(f"🎯 Thuật toán chọn K = {best_k} (Silhouette Score: {score:.4f} nếu K > 1)")

        if best_k == 1:
            cluster_ids = np.zeros(len(df), dtype=int)
        else:
            cluster_ids = KMeans(n_clusters=best_k, random_state=42, n_init=20).fit_predict(x_scaled)

        df["cluster_id"] = cluster_ids

        # Bước 4 & 5: Phân tích đặc điểm cụm & Gán nhãn mô tả
        profile = (
            df.groupby("cluster_id", as_index=False)
              .agg(
                  recency_days=("recency_days", "median"),
                  frequency=("frequency", "median"),
                  monetary=("monetary", "median"),
                  customer_count=("customer_unique_id", "count"),
              )
        )
        label_map = assign_segment_labels(profile)
        df["segment"] = df["cluster_id"].map(label_map).fillna("Khách hàng phổ thông")

        # Ép kiểu dữ liệu chuẩn theo hợp đồng đầu ra
        df["cluster_id"] = df["cluster_id"].astype(int)
        df["recency_days"] = df["recency_days"].astype(int)
        df["frequency"] = df["frequency"].astype(int)
        df["monetary"] = df["monetary"].astype(float)

        # Chuẩn bị DataFrame đầu ra đúng 6 cột yêu cầu
        result = df[
            ["customer_unique_id", "recency_days", "frequency", "monetary", "cluster_id", "segment"]
        ].copy()

        # Ghi kết quả vào bảng mart_customer_rfm
        con.register("kmeans_result_df", result)
        con.execute(f"CREATE OR REPLACE TABLE {target} AS SELECT * FROM kmeans_result_df")
        con.unregister("kmeans_result_df")

        # Kiểm tra kết quả sau khi lưu
        checks = con.execute(f"""
            SELECT 
                COUNT(*) AS total_rows,
                COUNT(DISTINCT customer_unique_id) AS unique_cust,
                COUNT(DISTINCT cluster_id) AS num_clusters,
                SUM(CASE WHEN segment IS NULL OR TRIM(segment) = '' THEN 1 ELSE 0 END) AS invalid_segments
            FROM {target}
        """).fetchone()

        print("\n================ RESULT SUMMARY ================")
        print(f"Đã ghi thành công bảng: {target}")
        print(f"Tổng số khách hàng (row_count): {checks[0]:,}")
        print(f"Số customer_unique_id duy nhất: {checks[1]:,}")
        print(f"Số cụm (cluster_id): {checks[2]}")
        print(f"Số dòng thiếu segment: {checks[3]}")
        print("================================================")

        # In mẫu 5 dòng đầu tiên của bảng kết quả
        sample_df = con.execute(f"SELECT * FROM {target} LIMIT 5").df()
        print("\nMẫu dữ liệu trong bảng mart_customer_rfm:")
        print(sample_df.to_string(index=False))

        return 0
    finally:
        con.close()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:
        print(f"❌ LỖI: {exc}", file=sys.stderr)
        sys.exit(1)
